# Installed as /etc/systemd/system/ultrathink-cert-renew.timer; it starts ultrathink-cert-renew.service.
# Enable: systemctl enable --now ultrathink-cert-renew.timer ; list: systemctl list-timers ultrathink-cert-renew
# Rollback: systemctl disable --now ultrathink-cert-renew.timer

[Unit]
Description=Hourly renewal check for ultrathink internal TLS leaves

[Timer]
OnCalendar=hourly
# Spread the start so the hourly check does not line up with other hourly jobs on the host.
RandomizedDelaySec=300
# A run missed while the host was off happens at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
