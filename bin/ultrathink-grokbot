#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 SWC Studio
# Grok Bot (Desk Lead) native planner: the host model answers the planner's requests; ship is always off.
set -eu
self=$0
while [ -L "$self" ]; do
	link=$(readlink -- "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname -- "$self")/$link ;;
	esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
ULTRATHINK_SHIP=0 ULTRATHINK_BUN_REQUIRED=1 exec "$root/bin/run-bun" "$root/src/host/grokbot-cli.ts" "$@"
