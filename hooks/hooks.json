{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/uplift.ts\"",
						"timeout": 86400,
						"statusMessage": "Ultrathink · Graph of Thought"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "AskUserQuestion",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/answers.ts\"",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "mcp__aio__github_create_pull_request|github_create_pull_request|mcp__github__create_pull_request",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-sync.ts\"",
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.ts\"",
						"timeout": 60
					}
				]
			}
		]
	}
}
