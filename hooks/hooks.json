{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/run-bun\" \"${CLAUDE_PLUGIN_ROOT}/hooks/uplift.ts\"",
						"timeout": 86400,
						"statusMessage": "Ultrathink · Graph of Thought"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "AskUserQuestion",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/run-bun\" \"${CLAUDE_PLUGIN_ROOT}/hooks/answers.ts\"",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "^(Bash|bash|run_terminal_cmd|run_terminal_command|shell|exec|terminal)$",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/run-bun\" \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-sync.ts\"",
						"timeout": 30
					}
				]
			},
			{
				"matcher": ".*([Cc]reate[_-]?[Pp]ull[_-]?[Rr]equest|[Pp]ull[_-]?[Rr]equest[_-]?[Cc]reate)$",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/run-bun\" \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-sync.ts\"",
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/run-bun\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.ts\"",
						"timeout": 60
					}
				]
			}
		]
	}
}
